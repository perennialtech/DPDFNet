# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Machine learning / model files
*.onnx
*.tflite
*.npz
# The package's ONNX reference fixture is small and must be tracked.
!package/tests/data/*.npz
*.pth
*.pt
*.ckpt

# TensorFlow checkpoints
checkpoint
*.ckpt.*

# TorchScript
*.torchscript

# Other common ML cache artifacts
*.npy
*.pb
*.h5

# IDE / editor junk (optional but recommended)
.vscode/
.idea/
*.swp

# pypi
package/CHANGELOG.md
package/CONTRIBUTING.md
*.whl
*.cfg
*.gz
*.egg-info/
package/build/

# Model Zoo
model_zoo/

# Local preservation of optimization research and developer validation.
/.local/
